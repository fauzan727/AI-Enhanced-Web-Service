# HTTP server
PORT=3000

# Amazon Bedrock (select a region/model enabled for your AWS account)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Optional local credentials; prefer an IAM role in deployed environments
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Request limits
BEDROCK_TIMEOUT_MS=30000
MAX_REQUEST_BYTES=16384
